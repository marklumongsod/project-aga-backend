# --- runtime
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (0 = none). Set 1 when nginx/a load balancer is the only way in.
TRUST_PROXY=0

# --- database (PostgreSQL 16 + PostGIS 3)
DATABASE_URL=postgresql://aga:aga@localhost:5432/aga?schema=public

# --- auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Demo office accounts created by the seed (CO / RO Region III / PO Nueva Ecija). Leave empty to skip.
SEED_DEMO_PASSWORD=ChangeMe!2026
# T2MIS single sign-on (OIDC). Leave empty until T2MIS provides the issuer; /auth/sso/t2mis then returns 501.
T2MIS_SSO_ISSUER=
T2MIS_SSO_CLIENT_ID=
T2MIS_SSO_CLIENT_SECRET=

# --- simulation (Team C utilization algorithm)
SIM_LIMIT_MINUTES=90
# fastest average straight-line speed on any road (km/h); only bounds how far to look, reach is by road minutes
SIM_MAX_SPEED_KMH=90
SIM_CRON=0 2 * * *
# Travel time: estimate (straight line x detour / speed, +ferry) or osrm (real road + ferry times from OpenStreetMap).
# For osrm: sh scripts/osrm-prepare.sh && docker compose --profile routing up -d osrm && npm run travel:build
TRAVEL_MODEL=estimate
OSRM_URL=http://localhost:5001
OSRM_FOOT_URL=http://localhost:5002
OSRM_TIMEOUT_MS=5000

# --- TESDA Assessor Coverage API (assessment centers, their qualifications, upcoming graduates)
# Synced nightly just before the simulation (SIM_CRON), or by hand with `npm run tesda:sync`.
# Every call needs the key; the students list needs a key with the "students" permission. Never commit a real key.
TESDA_API_URL=https://sap-sis.tesda.gov.ph
TESDA_API_KEY=
TESDA_API_TIMEOUT_MS=20000

# --- public API rate limit
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60            # public finder and sign-in: requests per minute per IP
THROTTLE_OFFICE_LIMIT=600     # signed-in office users: requests per minute per account
