{
  "name": "project-aga-backend",
  "version": "0.1.0",
  "description": "Project AGA - AI-Based Assessment Center Gap Analysis API (TESDA Team C)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:cov": "jest --coverage",
    "db:migrate": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "db:seed": "ts-node --transpile-only src/database/seed.ts",
    "simulate": "ts-node --transpile-only src/cli/simulate.ts",
    "tesda:sync": "ts-node --transpile-only src/cli/sync-tesda.ts",
    "travel:build": "ts-node --transpile-only src/cli/build-travel-matrix.ts",
    "etl": "python3 -I etl/build_seed.py",
    "db:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run tesda:sync && npm run data:quality -- --apply",
    "db:migrate:prod": "typeorm migration:run -d dist/database/data-source.js",
    "db:seed:prod": "node dist/database/seed.js",
    "simulate:prod": "node dist/cli/simulate.js",
    "tesda:sync:prod": "node dist/cli/sync-tesda.js",
    "travel:build:prod": "node dist/cli/build-travel-matrix.js",
    "qa:travel": "ts-node --transpile-only src/cli/travel-spotcheck.ts",
    "data:quality": "ts-node --transpile-only src/cli/data-quality.ts",
    "demo:utilization": "ts-node --transpile-only src/cli/demo-utilization.ts",
    "data:quality:prod": "node dist/cli/data-quality.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "@turf/helpers": "^7.4.0",
    "@turf/isobands": "^7.4.0",
    "@turf/point-grid": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "@turf/union": "^7.4.0",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.1",
    "cron": "^4.4.0",
    "dotenv": "^16.6.1",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "^8.23.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@turf/area": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "29.5.14",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "29.7.0",
    "pino-pretty": "13.2.0",
    "prettier": "^3.3.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.module.ts",
      "!main.ts",
      "!cli/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
